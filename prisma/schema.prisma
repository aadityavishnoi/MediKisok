generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core System & Domain Enums
// ---------------------------------------------------------------------------

enum crdb_internal_region {
  aws_ap_south_1 @map("aws-ap-south-1")
}

enum ConsentStatus {
  PENDING
  GRANTED
  DECLINED
  REVOKED
}

enum DocumentType {
  PRESCRIPTION
  LAB_REPORT
  DISCHARGE_SUMMARY
  OTHER
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RFIDCardStatus {
  MANUFACTURED
  AVAILABLE
  ASSIGNED
  ACTIVE
  SUSPENDED
  LOST
  STOLEN
  BLOCKED
  REPLACED
  RETIRED
}

enum AIModelStatus {
  DRAFT
  VALIDATING
  APPROVED
  STAGED
  DEPLOYED
  RETIRED
  REJECTED
}

enum SessionStatus {
  CREATED
  IDENTIFIED
  CONSENTED
  IN_HISTORY
  DOCUMENTS
  SUMMARY_READY
  ROUTED
  IN_CONSULT
  COMPLETED
  ABANDONED
}

enum Mode {
  GENERAL
  AYUSH
}

enum Language {
  EN
  HI
  BN
  MR
  TE
  TA
  GU
  KN
  ML
  PA
  OR
  AS
  UR
}

enum ExtractionFieldStatus {
  VERIFIED
  NEEDS_VERIFICATION
}

enum TimelineEventType {
  DIAGNOSIS
  MEDICATION
  INVESTIGATION
  PROCEDURE
  VISIT
}

enum ActorType {
  PATIENT
  DOCTOR
  ADMIN
  SYSTEM
  DEVICE
}

enum IdentificationMethod {
  RFID
  QR
  MANUAL
  DEMO
}

enum AISummaryStatus {
  DRAFT
  CONFIRMED
}

enum ConsultationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DoctorRole {
  DOCTOR
  ADMIN
  HOSPITAL_ADMIN
  RFID_OFFICER
  CENTRAL_ADMIN
  SUPER_ADMIN
}

enum HospitalType {
  AIIMS
  TERTIARY_HOSPITAL
  DISTRICT_HOSPITAL
  COMMUNITY_HEALTH_CENTRE
  PRIMARY_HEALTH_CENTRE
  PRIVATE_HOSPITAL
}

enum TriagePriority {
  NORMAL
  URGENT
  EMERGENCY
}

enum QueueStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
}

enum DoctorStatus {
  AVAILABLE
  IN_CONSULTATION
  OFF_DUTY
}

enum KioskStatus {
  ONLINE
  DEGRADED
  OFFLINE
}

enum PrescriptionFrequency {
  OD
  BD
  TDS
  QID
  PRN
  SOS
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TEXT
  NUMBER
  DATE
  BOOLEAN
}

enum FacilityStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  SUSPENDED
  INACTIVE
  REJECTED
}

enum ScopeLevel {
  NATIONAL
  STATE
  DISTRICT
  FACILITY
  DEPARTMENT
}

enum IdentifierType {
  RFID
  ABHA
  PHONE
  NATIONAL_ID
  HOSPITAL_MRN
}

enum RFIDEventType {
  CARD_REGISTERED
  CARD_ASSIGNED
  CARD_ACTIVATED
  CARD_BLOCKED
  CARD_LOST
  CARD_REPLACED
  CARD_REISSUED
  CARD_RETIRED
  CARD_SCANNED
}

enum DeviceEventType {
  HEARTBEAT
  ONLINE
  OFFLINE
  MAINTENANCE
  DISABLED
  ERROR
  FIRMWARE_UPDATE
  SCANNER_TRIGGER
}

enum OperationalAlertType {
  KIOSK_OFFLINE
  RFID_READER_FAILURE
  QUEUE_OVERLOAD
  DEVICE_ERROR
  NETWORK_LATENCY
  PRINTER_PAPER_LOW
}

enum NoteType {
  SUBJECTIVE
  OBJECTIVE
  ASSESSMENT
  PLAN
  GENERAL
}

enum AIAssistanceType {
  SUMMARY
  TRIAGE_ROUTING
  DIAGNOSTIC_SUGGESTION
  SAFETY_CHECK
}

enum DeploymentEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum DeploymentStatus {
  DRAFT
  VALIDATING
  APPROVED
  STAGED
  DEPLOYED
  ROLLED_BACK
  RETIRED
  REJECTED
}

enum NotificationType {
  CLINICAL_ALERT
  SYSTEM_ALERT
  DEVICE_ALERT
  QUEUE_ALERT
  ADMIN_ALERT
}

enum InteropTransactionType {
  FHIR_BUNDLE_EXPORT
  ABHA_LOOKUP
  CONSENT_REQUEST
  DISCHARGE_SUMMARY_PUSH
}

// ---------------------------------------------------------------------------
// 1. National & Regional Governance Hierarchy
// ---------------------------------------------------------------------------

model NationalAuthority {
  id        String   @id @default(cuid())
  name      String // "National Health Authority"
  code      String   @unique // "NHA-INDIA"
  country   String   @default("India")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states State[]
}

model State {
  id                  String   @id @default(cuid())
  nationalAuthorityId String?
  name                String // "Delhi", "Maharashtra"
  code                String   @unique // "DL", "MH"
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  nationalAuthority NationalAuthority? @relation(fields: [nationalAuthorityId], references: [id])
  districts         District[]
  hospitals         Hospital[]

  @@index([nationalAuthorityId])
}

model District {
  id        String   @id @default(cuid())
  stateId   String
  name      String // "South Delhi", "Pune"
  code      String // "DL-SD", "MH-PU"
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state     State      @relation(fields: [stateId], references: [id])
  hospitals Hospital[]

  @@unique([stateId, code])
  @@index([stateId])
}

// ---------------------------------------------------------------------------
// 2. Multi-Hospital & Facility Governance (Primary Operational Tenant)
// ---------------------------------------------------------------------------

model Hospital {
  id             String         @id @default(cuid())
  code           String         @unique // e.g. "AIIMS-DEL-01"
  name           String // "All India Institute of Medical Sciences, New Delhi"
  type           HospitalType   @default(AIIMS)
  state          String // Legacy text representation: "Delhi"
  district       String // Legacy text representation: "South Delhi"
  stateId        String?
  districtId     String?
  facilityStatus FacilityStatus @default(ACTIVE)
  city           String // "New Delhi"
  pinCode        String?
  address        String?
  latitude       Float?
  longitude      Float?
  contactPhone   String?
  contactEmail   String?
  totalBeds      Int            @default(2500)
  availableBeds  Int            @default(340)
  totalKiosks    Int            @default(12)
  activeKiosks   Int            @default(11)
  abdmFacilityId String?        @unique // HFR ID e.g. "IN0710000001"
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  stateRel           State?                        @relation(fields: [stateId], references: [id])
  districtRel        District?                     @relation(fields: [districtId], references: [id])
  departments        Department[]
  doctors            Doctor[]
  kiosks             RFIDDevice[]
  rfidCards          RFIDCard[]
  sessions           PatientSession[]
  triageQueues       TriageQueue[]
  patients           Patient[]                     @relation("HospitalPatients")
  registeredPatients Patient[]                     @relation("RegisteredFacilityPatients")
  outbreaks          DiseaseOutbreakSignal[]
  rfidEvents         RFIDEvent[]
  operationalAlerts  OperationalAlert[]
  systemConfigs      SystemConfig[]
  fhirMappings       FHIRResourceMapping[]
  transactions       InteroperabilityTransaction[]
  appointments       Appointment[]

  @@index([stateId])
  @@index([districtId])
  @@index([facilityStatus])
}

model Department {
  id               String   @id @default(cuid())
  hospitalId       String
  name             String // "Cardiology", "Pediatrics"
  code             String // "CARD", "PEDS"
  floor            String? // "1st Floor, Block B"
  roomNumber       String? // "Room 102"
  active           Boolean  @default(true)
  headOfDepartment String?
  createdAt        DateTime @default(now())

  hospital     Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctors      Doctor[]
  triageQueues TriageQueue[]
  sessions     PatientSession[]
  appointments Appointment[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
}

// ---------------------------------------------------------------------------
// 3. Normalized Role-Based Access Control (RBAC) & Staff
// ---------------------------------------------------------------------------

model Role {
  id          String     @id @default(cuid())
  code        String     @unique // "SUPER_ADMIN", "CENTRAL_ADMIN", "HOSPITAL_ADMIN", "DOCTOR", "RFID_OFFICER", "AUDITOR"
  name        String // "Hospital Administrator"
  scopeLevel  ScopeLevel @default(FACILITY)
  description String?
  createdAt   DateTime   @default(now())

  permissions RolePermission[]
  userRoles   UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // "patient.read", "rfid.activate", "clinical.consult"
  category    String // "PATIENT", "RFID", "CLINICAL", "FACILITY", "DEVICE", "AI_MODEL", "AUDIT"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id         String   @id @default(cuid())
  doctorId   String // links to Doctor (user)
  roleId     String
  facilityId String?
  stateId    String?
  districtId String?
  assignedAt DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([doctorId, roleId, facilityId])
}

model Doctor {
  id                 String       @id @default(cuid())
  hospitalId         String?
  departmentId       String?
  name               String
  email              String       @unique
  passwordHash       String
  role               DoctorRole   @default(DOCTOR)
  status             DoctorStatus @default(AVAILABLE)
  department         String? // text label fallback
  roomNumber         String?
  qualification      String?
  registrationNumber String?
  avgConsultMinutes  Float?       @default(4.5)
  createdAt          DateTime     @default(now())

  hospital             Hospital?             @relation(fields: [hospitalId], references: [id])
  departmentRel        Department?           @relation(fields: [departmentId], references: [id])
  consultations        Consultation[]
  triageQueues         TriageQueue[]
  prescriptions        Prescription[]
  userRoles            UserRole[]
  doctorNotes          DoctorNote[]
  appointments         Appointment[]
  patientPrescriptions PatientPrescription[]

  @@index([hospitalId])
  @@index([departmentId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// 4. Patient & Normalized Identification
// ---------------------------------------------------------------------------

model Patient {
  id                   String               @id @default(cuid())
  hospitalId           String?
  fullName             String
  dateOfBirth          DateTime?
  age                  Int?
  gender               String?
  bloodGroup           String?
  phone                String?              @unique
  email                String?              @unique
  passwordHash         String?
  address              String?
  emergencyContact     String?
  emergencyPhone       String?
  registeredFacilityId String?
  abhaId               String?
  registrationSource   IdentificationMethod
  isDemo               Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  hospital             Hospital?              @relation("HospitalPatients", fields: [hospitalId], references: [id])
  registeredFacility   Hospital?              @relation("RegisteredFacilityPatients", fields: [registeredFacilityId], references: [id])
  rfidCards            RFIDCard[]
  identifiers          PatientIdentifier[]
  sessions             PatientSession[]
  clinicalHistories    ClinicalHistory[]
  documents            MedicalDocument[]
  timelineEvents       MedicalTimelineEvent[]
  consultations        Consultation[]
  alerts               Alert[]
  aiSummaries          AISummary[]
  triageQueues         TriageQueue[]
  vitals               PatientVitals[]
  prescriptions        Prescription[]
  abdmConsents         AbdmConsentArtefact[]
  symptoms             SessionSymptom[]
  appointments         Appointment[]
  invoices             BillingInvoice[]
  patientNotifications PatientNotification[]
  patientPrescriptions PatientPrescription[]

  @@index([hospitalId])
  @@index([registeredFacilityId])
  @@index([fullName])
  @@index([createdAt])
}

model PatientIdentifier {
  id         String         @id @default(cuid())
  patientId  String
  type       IdentifierType
  value      String
  status     String         @default("ACTIVE")
  verified   Boolean        @default(false)
  verifiedAt DateTime?
  createdAt  DateTime       @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([patientId, type])
}

// ---------------------------------------------------------------------------
// 5. Smart Card RFID Lifecycle & Event Stream
// ---------------------------------------------------------------------------

model RFIDCard {
  id                  String         @id @default(cuid())
  hospitalId          String?
  uid                 String         @unique
  patientId           String?
  cardType            String?        @default("STANDARD_MIFARE")
  isDemo              Boolean        @default(false)
  active              Boolean        @default(true) // legacy compat - derived from cardStatus
  cardStatus          RFIDCardStatus @default(AVAILABLE)
  blockReason         String?
  cardStatusChangedAt DateTime?
  issuedAt            DateTime       @default(now())
  activatedAt         DateTime?
  blockedAt           DateTime?
  replacedAt          DateTime?
  retiredAt           DateTime?

  hospital Hospital?   @relation(fields: [hospitalId], references: [id])
  patient  Patient?    @relation(fields: [patientId], references: [id])
  events   RFIDEvent[]

  @@index([hospitalId, cardStatus])
  @@index([patientId])
}

model RFIDEvent {
  id         String        @id @default(cuid())
  rfidCardId String?
  cardUid    String
  facilityId String?
  actorId    String?
  eventType  RFIDEventType
  metadata   Json?
  timestamp  DateTime      @default(now())

  rfidCard RFIDCard? @relation(fields: [rfidCardId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [facilityId], references: [id])

  @@index([cardUid, timestamp])
  @@index([facilityId, timestamp])
  @@index([rfidCardId])
}

// ---------------------------------------------------------------------------
// 6. Hardware Terminal & Device Telemetry
// ---------------------------------------------------------------------------

model RFIDDevice {
  id                  String      @id @default(cuid())
  hospitalId          String?
  deviceCode          String      @unique
  location            String?
  kioskType           String?     @default("SELF_SERVICE")
  status              KioskStatus @default(ONLINE)
  printerPaperPercent Int?        @default(85)
  lastHeartbeatAt     DateTime?
  firmwareVersion     String?
  ipAddress           String?
  isDemo              Boolean     @default(false)
  createdAt           DateTime    @default(now())

  hospital          Hospital?          @relation(fields: [hospitalId], references: [id])
  sessions          PatientSession[]
  heartbeats        DeviceHeartbeat[]
  events            DeviceEvent[]
  operationalAlerts OperationalAlert[]

  @@index([hospitalId, status])
}

model DeviceHeartbeat {
  id         String   @id @default(cuid())
  deviceId   String
  status     String   @default("ONLINE")
  metrics    Json? // { cpuPct, memPct, printerPaperPercent, rfSignalDbm }
  recordedAt DateTime @default(now())

  device RFIDDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt])
}

model DeviceEvent {
  id        String          @id @default(cuid())
  deviceId  String
  eventType DeviceEventType
  severity  AlertSeverity   @default(LOW)
  message   String
  metadata  Json?
  createdAt DateTime        @default(now())

  device RFIDDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
}

// ---------------------------------------------------------------------------
// 7. Patient Intake Session (Kiosk Lifecycle)
// ---------------------------------------------------------------------------

model PatientSession {
  id            String                @id @default(cuid())
  hospitalId    String?
  patientId     String?
  deviceId      String?
  departmentId  String?
  status        SessionStatus         @default(CREATED)
  mode          Mode                  @default(GENERAL)
  language      Language              @default(EN)
  isDemo        Boolean               @default(false)
  identifiedVia IdentificationMethod?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  hospital        Hospital?         @relation(fields: [hospitalId], references: [id])
  patient         Patient?          @relation(fields: [patientId], references: [id])
  device          RFIDDevice?       @relation(fields: [deviceId], references: [id])
  department      Department?       @relation(fields: [departmentId], references: [id])
  consent         Consent?
  clinicalHistory ClinicalHistory?
  documents       MedicalDocument[]
  aiSummary       AISummary?
  consultation    Consultation?
  triageQueue     TriageQueue?
  vitals          PatientVitals?
  alerts          Alert[]
  symptoms        SessionSymptom[]
  ocrJobs         OCRJob[]
  aiAssistances   AIAssistance[]

  @@index([patientId, status])
  @@index([hospitalId, status])
  @@index([deviceId])
  @@index([departmentId])
  @@index([createdAt])
}

model Consent {
  id                 String        @id @default(cuid())
  sessionId          String        @unique
  status             ConsentStatus @default(PENDING)
  language           Language
  consentTextVersion String
  grantedAt          DateTime?
  ipAddress          String?
  createdAt          DateTime      @default(now())

  session PatientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ClinicalHistory {
  id                     String    @id @default(cuid())
  sessionId              String    @unique
  patientId              String
  mode                   Mode
  chiefComplaint         String?
  chiefComplaintCategory String?
  currentTreeId          String?
  currentNodeId          String?
  hpi                    Json?
  pastMedicalHistory     Json?
  pastSurgicalHistory    Json?
  currentMedications     Json?
  drugAllergies          Json?
  familyHistory          Json?
  personalHistory        Json?
  reviewOfSystems        Json?
  previousInvestigations Json?
  ayushFields            Json?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())

  session PatientSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient Patient          @relation(fields: [patientId], references: [id])
  answers ClinicalAnswer[]

  @@index([patientId])
}

model ClinicalAnswer {
  id                    String   @id @default(cuid())
  clinicalHistoryId     String
  nodeId                String
  section               String
  questionText          String
  questionTextLocalized Json?
  answerValue           Json
  isRedFlagTrigger      Boolean  @default(false)
  answeredAt            DateTime @default(now())

  clinicalHistory ClinicalHistory @relation(fields: [clinicalHistoryId], references: [id], onDelete: Cascade)

  @@index([clinicalHistoryId])
}

model PatientVitals {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  patientId    String
  systolicBp   Int? // e.g. 120
  diastolicBp  Int? // e.g. 80
  pulse        Int? // e.g. 72
  spo2         Int? // e.g. 98
  temperatureF Float? // e.g. 98.6
  heightCm     Float? // e.g. 172
  weightKg     Float? // e.g. 68
  bmi          Float? // e.g. 23.0
  source       String?  @default("KIOSK_IOT")
  recordedAt   DateTime @default(now())

  session PatientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient Patient        @relation(fields: [patientId], references: [id])

  @@index([patientId])
}

// ---------------------------------------------------------------------------
// 8. Questionnaire & Clinical Decision Trees
// ---------------------------------------------------------------------------

model Questionnaire {
  id        String   @id @default(cuid())
  code      String   @unique // "GEN_OPD_V1", "CARD_V1", "AYUSH_V1"
  title     String // "General OPD Clinical History"
  category  String // "TRIAGE", "CHIEF_COMPLAINT", "AYUSH"
  version   String   @default("1.0")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  questions Question[]
}

model Question {
  id               String       @id @default(cuid())
  questionnaireId  String
  nodeId           String // tree node identifier
  text             String
  textLocalized    Json?
  type             QuestionType @default(SINGLE_CHOICE)
  section          String // "CHIEF_COMPLAINT", "HPI", "RED_FLAGS"
  sequence         Int          @default(0)
  isRedFlagTrigger Boolean      @default(false)
  required         Boolean      @default(true)

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@unique([questionnaireId, nodeId])
  @@index([questionnaireId])
}

model SessionSymptom {
  id          String        @id @default(cuid())
  sessionId   String
  patientId   String
  symptomName String // "Chest Pain", "High Fever"
  symptomCode String? // ICD-10 e.g. "R07.9"
  severity    AlertSeverity @default(MEDIUM)
  duration    String? // "3 days"
  isRedFlag   Boolean       @default(false)
  source      String        @default("PATIENT") // "PATIENT", "DOCTOR", "AI_DERIVED"
  createdAt   DateTime      @default(now())

  session PatientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([sessionId, isRedFlag])
  @@index([symptomName])
  @@index([patientId])
}

// ---------------------------------------------------------------------------
// 9. Document OCR & Multimodal Ingestion Pipeline
// ---------------------------------------------------------------------------

model MedicalDocument {
  id               String       @id @default(cuid())
  sessionId        String
  patientId        String
  type             DocumentType
  originalFilename String
  storagePath      String
  mimeType         String
  ocrText          String?
  ocrConfidence    Float?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())

  session        PatientSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient        Patient                @relation(fields: [patientId], references: [id])
  extractedData  ExtractedMedicalData[]
  timelineEvents MedicalTimelineEvent[]
  ocrJobs        OCRJob[]

  @@index([patientId])
  @@index([sessionId])
}

model ExtractedMedicalData {
  id         String                @id @default(cuid())
  documentId String
  fieldType  String
  fieldValue String
  confidence Float
  status     ExtractionFieldStatus @default(NEEDS_VERIFICATION)
  verifiedBy String?
  verifiedAt DateTime?

  document MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model OCRJob {
  id             String    @id @default(cuid())
  documentId     String
  sessionId      String?
  status         String    @default("COMPLETED") // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  provider       String    @default("LOCAL") // "LOCAL", "GEMINI_VISION", "IMAGEKIT"
  modelVersion   String    @default("MediOCR-v2.1")
  rawText        String?
  structuredData Json?
  confidence     Float?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  document MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  session  PatientSession? @relation(fields: [sessionId], references: [id])

  @@index([documentId, status])
  @@index([sessionId])
}

model MedicalTimelineEvent {
  id               String            @id @default(cuid())
  patientId        String
  sourceDocumentId String?
  eventType        TimelineEventType
  eventDate        DateTime?
  title            String
  description      String?
  metadata         Json?
  createdAt        DateTime          @default(now())

  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sourceDocument MedicalDocument? @relation(fields: [sourceDocumentId], references: [id])

  @@index([patientId, eventDate])
  @@index([sourceDocumentId])
}

model AISummary {
  id                  String          @id @default(cuid())
  sessionId           String          @unique
  patientId           String
  content             String
  generatorType       String
  status              AISummaryStatus @default(DRAFT)
  editedContent       String?
  confirmedByDoctorId String?
  confirmedAt         DateTime?
  createdAt           DateTime        @default(now())

  session PatientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient Patient        @relation(fields: [patientId], references: [id])

  @@index([patientId])
}

// ---------------------------------------------------------------------------
// 10. Live OPD Queue & Triage Routing
// ---------------------------------------------------------------------------

model TriageQueue {
  id                String         @id @default(cuid())
  sessionId         String         @unique
  patientId         String
  hospitalId        String
  departmentId      String?
  doctorId          String?
  tokenNumber       String // e.g. "CARD-102"
  priority          TriagePriority @default(NORMAL)
  status            QueueStatus    @default(WAITING)
  estimatedWaitMins Int            @default(15)
  queuedAt          DateTime       @default(now())
  calledAt          DateTime?
  completedAt       DateTime?

  session    PatientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient    Patient        @relation(fields: [patientId], references: [id])
  hospital   Hospital       @relation(fields: [hospitalId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  doctor     Doctor?        @relation(fields: [doctorId], references: [id])

  @@index([hospitalId, status])
  @@index([doctorId, status])
  @@index([patientId])
  @@index([priority, status])
}

// ---------------------------------------------------------------------------
// 11. Clinical Consultation, Doctor Notes & Digital Prescriptions
// ---------------------------------------------------------------------------

model Consultation {
  id          String             @id @default(cuid())
  sessionId   String             @unique
  patientId   String
  doctorId    String?
  status      ConsultationStatus @default(PENDING)
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?

  session       PatientSession @relation(fields: [sessionId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        Doctor?        @relation(fields: [doctorId], references: [id])
  prescription  Prescription?
  notesRel      DoctorNote[]
  aiAssistances AIAssistance[]

  @@index([patientId])
  @@index([doctorId, status])
}

model DoctorNote {
  id             String   @id @default(cuid())
  consultationId String
  doctorId       String
  noteType       NoteType @default(GENERAL)
  content        String
  authoredAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  doctor       Doctor       @relation(fields: [doctorId], references: [id])

  @@index([consultationId, noteType])
  @@index([doctorId])
}

model AIAssistance {
  id                   String           @id @default(cuid())
  sessionId            String
  consultationId       String?
  modelVersion         String // "ClinicalSummarizer-v1.4"
  assistanceType       AIAssistanceType @default(SUMMARY)
  content              String
  provenanceReferences Json? // e.g. {"answerId": "123", "documentId": "456"}
  feedback             String? // "ACCEPTED", "REJECTED", "EDITED"
  createdAt            DateTime         @default(now())

  session      PatientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  consultation Consultation?  @relation(fields: [consultationId], references: [id])

  @@index([sessionId, assistanceType])
  @@index([consultationId])
}

model Prescription {
  id             String    @id @default(cuid())
  consultationId String    @unique
  patientId      String
  doctorId       String
  diagnosis      String
  clinicalNotes  String?
  followUpDays   Int?      @default(7)
  dispensed      Boolean   @default(false)
  dispensedAt    DateTime?
  createdAt      DateTime  @default(now())

  consultation Consultation       @relation(fields: [consultationId], references: [id])
  patient      Patient            @relation(fields: [patientId], references: [id])
  doctor       Doctor             @relation(fields: [doctorId], references: [id])
  items        PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
}

model PrescriptionItem {
  id             String                @id @default(cuid())
  prescriptionId String
  medicineName   String // "Pantop 40mg", "Paracetamol 500mg"
  dosage         String? // "1 Tablet"
  frequency      PrescriptionFrequency @default(BD)
  durationDays   Int                   @default(5)
  instructions   String? // "After food", "Empty stomach"
  timing         String? // "Morning & Evening"

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

// ---------------------------------------------------------------------------
// 12. Clinical Alerts (Red Flags) vs Operational Incidents
// ---------------------------------------------------------------------------

model Alert {
  id                     String        @id @default(cuid())
  sessionId              String
  patientId              String
  severity               AlertSeverity
  triggerType            String
  message                String
  triggeredByAnswerId    String?
  acknowledged           Boolean       @default(false)
  acknowledgedByDoctorId String?
  acknowledgedAt         DateTime?
  createdAt              DateTime      @default(now())

  session PatientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient Patient        @relation(fields: [patientId], references: [id])

  @@index([sessionId])
  @@index([patientId, acknowledged])
}

model OperationalAlert {
  id             String               @id @default(cuid())
  facilityId     String
  deviceId       String?
  alertType      OperationalAlertType
  severity       AlertSeverity        @default(MEDIUM)
  message        String
  acknowledged   Boolean              @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime             @default(now())

  hospital Hospital    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  device   RFIDDevice? @relation(fields: [deviceId], references: [id])

  @@index([facilityId, acknowledged])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String? // doctor or staff ID
  facilityId  String?
  type        NotificationType
  severity    AlertSeverity    @default(MEDIUM)
  title       String
  message     String
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([recipientId, readAt])
  @@index([facilityId, createdAt])
}

// ---------------------------------------------------------------------------
// 13. National Surveillance & AI Model Governance Registry
// ---------------------------------------------------------------------------

model DiseaseOutbreakSignal {
  id           String        @id @default(cuid())
  hospitalId   String
  diseaseName  String // "Dengue Fever", "Malaria", "Typhoid", "Viral Influenza"
  category     String? // "VECTOR_BORNE", "RESPIRATORY", "WATER_BORNE"
  icd10Code    String? // "A90", "B54", "A01.0"
  caseCount    Int           @default(1)
  severity     AlertSeverity @default(MEDIUM)
  district     String
  state        String
  reportedDate DateTime      @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@index([state, district, diseaseName])
  @@index([hospitalId])
}

model AIModel {
  id          String        @id @default(cuid())
  name        String
  version     String
  modelType   String // "SUMMARIZER", "OCR_LAYOUT", "SYMPTOM_CLASSIFIER"
  status      AIModelStatus @default(DRAFT)
  owner       String? // team or organization
  description String?
  metrics     Json? // { cer: 0.021, f1: 0.962, latency_ms: 420 }
  isDemo      Boolean       @default(true)
  approvedBy  String?
  approvedAt  DateTime?
  deployedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  versions AIModelVersion[]

  @@index([status])
}

model AIModelVersion {
  id            String        @id @default(cuid())
  modelId       String
  versionNumber String // "v2.1"
  status        AIModelStatus @default(DRAFT)
  metrics       Json? // { cer, f1, accuracy, latency_ms }
  artifactUrl   String?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())

  model       AIModel             @relation(fields: [modelId], references: [id], onDelete: Cascade)
  deployments AIModelDeployment[]

  @@unique([modelId, versionNumber])
}

model AIModelDeployment {
  id             String                @id @default(cuid())
  versionId      String
  environment    DeploymentEnvironment @default(DEVELOPMENT)
  facilityId     String?
  status         DeploymentStatus      @default(DEPLOYED)
  deployedAt     DateTime              @default(now())
  deployedBy     String?
  rollbackReason String?

  version AIModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, environment])
}

// ---------------------------------------------------------------------------
// 14. Interoperability (FHIR R4 & ABDM Compliance - DEMO / PRODUCTION)
// ---------------------------------------------------------------------------

model AbdmConsentArtefact {
  id                String        @id @default(cuid())
  patientId         String
  abhaAddress       String
  consentArtefactId String        @unique
  hipId             String // Hospital Health Information Provider ID
  hiuId             String? // Health Information User ID
  purpose           String        @default("CARETREAT")
  status            ConsentStatus @default(GRANTED)
  dateFrom          DateTime?
  dateTo            DateTime?
  expiryDate        DateTime
  createdAt         DateTime      @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
}

model FHIRResourceMapping {
  id               String   @id @default(cuid())
  facilityId       String
  resourceType     String // "Patient", "Encounter", "Observation"
  internalEntityId String
  fhirResourceId   String
  status           String   @default("DEMO") // "DEMO", "SYNCED", "FAILED"
  payload          Json
  lastSyncedAt     DateTime @default(now())

  hospital Hospital @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, resourceType, internalEntityId])
}

model InteroperabilityTransaction {
  id              String                 @id @default(cuid())
  facilityId      String
  transactionType InteropTransactionType
  mode            String                 @default("DEMO")
  status          String                 @default("SUCCESS")
  requestPayload  Json?
  responsePayload Json?
  createdAt       DateTime               @default(now())

  hospital Hospital @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, transactionType])
}

// ---------------------------------------------------------------------------
// 15. Governance, Audit Trail & System Configuration
// ---------------------------------------------------------------------------

model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String?
  facilityId String? // for tenant-scoped audit queries
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([facilityId, createdAt])
  @@index([action, createdAt])
}

model SystemConfig {
  id          String   @id @default(cuid())
  facilityId  String? // null = national configuration
  configKey   String
  configValue Json
  category    String // "FEATURE_FLAGS", "KIOSK_SETTINGS", "LOCALIZATION"
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  hospital Hospital? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, configKey])
}

model OtpVerification {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

// ---------------------------------------------------------------------------
// Patient Portal Domain Enums
// ---------------------------------------------------------------------------

enum AppointmentType {
  IN_PERSON
  VIDEO_CONSULT
  FOLLOW_UP
  EMERGENCY
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum BillingStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  CASH
  ABDM_INSURANCE
}

enum PatientNotificationType {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  PRESCRIPTION_ISSUED
  LAB_REPORT_READY
  BILL_GENERATED
  BILL_PAID
  HEALTH_ALERT
}

// ---------------------------------------------------------------------------
// Patient Portal Domain Models
// ---------------------------------------------------------------------------

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String
  doctorId           String?
  facilityId         String?
  departmentId       String?
  appointmentDate    DateTime
  timeSlot           String
  type               AppointmentType   @default(IN_PERSON)
  status             AppointmentStatus @default(SCHEDULED)
  reason             String
  notes              String?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patient       Patient               @relation(fields: [patientId], references: [id])
  doctor        Doctor?               @relation(fields: [doctorId], references: [id])
  facility      Hospital?             @relation(fields: [facilityId], references: [id])
  department    Department?           @relation(fields: [departmentId], references: [id])
  invoices      BillingInvoice[]
  prescriptions PatientPrescription[]

  @@index([patientId, appointmentDate])
  @@index([doctorId, appointmentDate])
  @@index([facilityId, status])
  @@index([departmentId])
}

model BillingInvoice {
  id                   String         @id @default(cuid())
  patientId            String
  appointmentId        String?
  invoiceNumber        String         @unique
  description          String
  department           String?
  totalAmount          Float
  discountAmount       Float          @default(0)
  netAmount            Float
  status               BillingStatus  @default(PENDING)
  paymentMethod        PaymentMethod?
  paymentDate          DateTime?
  transactionReference String?
  items                Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([patientId, status])
  @@index([appointmentId])
}

model PatientNotification {
  id        String                  @id @default(cuid())
  patientId String
  title     String
  message   String
  type      PatientNotificationType
  read      Boolean                 @default(false)
  actionUrl String?
  createdAt DateTime                @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, read, createdAt])
}

model PatientPrescription {
  id               String   @id @default(cuid())
  patientId        String
  doctorId         String?
  appointmentId    String?
  prescriptionDate DateTime @default(now())
  diagnosis        String
  instructions     String?
  medications      Json
  pdfUrl           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id])
  doctor      Doctor?      @relation(fields: [doctorId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([patientId, prescriptionDate])
  @@index([doctorId])
  @@index([appointmentId])
}
