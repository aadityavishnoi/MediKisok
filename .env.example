# Copy this file to .env and fill in real values. Never commit .env.

# --- Backend server ---
PORT=4000
NODE_ENV=development

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://medikiosk:medikiosk@localhost:5432/medikiosk?schema=public"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="12h"

# --- Hardware device auth (ESP32 sends this header) ---
DEVICE_KEY="replace-with-a-long-random-string"

# --- Demo mode ---
# When true: unlocks POST /api/rfid/simulate and the kiosk "Simulate RFID Scan" buttons.
# Never fakes hardware status - that is always derived from real heartbeats.
DEMO_MODE=true

# --- AI provider ---
# LOCAL (default, fully offline, real deterministic engine + tesseract OCR) | MOCK | REAL
AI_PROVIDER=LOCAL

# Optional: only used if AI_PROVIDER=REAL is explicitly requested AND this is set.
# Enhances summary/follow-up wording only - never controls red-flag or branching logic.
ANTHROPIC_API_KEY=

# --- CORS ---
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"
