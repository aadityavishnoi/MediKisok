{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClinicalSignal",
  "type": "object",
  "required": ["sessionId", "patientId", "normalizedSymptoms", "triageAcuity", "redFlagStatus", "generatedAt"],
  "properties": {
    "sessionId": { "type": "string" },
    "patientId": { "type": "string" },
    "normalizedSymptoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symptomCode", "symptomName", "confidence"],
        "properties": {
          "symptomCode": { "type": "string" },
          "symptomName": { "type": "string" },
          "durationDays": { "type": "number" },
          "severity": { "type": "string", "enum": ["MILD", "MODERATE", "SEVERE"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "triageAcuity": {
      "type": "string",
      "enum": ["GREEN_NON_URGENT", "YELLOW_URGENT", "ORANGE_EMERGENT", "RED_RESUSCITATION"]
    },
    "redFlagStatus": {
      "type": "string",
      "enum": ["NONE", "POTENTIAL", "CRITICAL_CONFIRMED"]
    },
    "suspectedDifferentials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["diseaseName", "icd10Code", "likelihoodScore"],
        "properties": {
          "diseaseName": { "type": "string" },
          "icd10Code": { "type": "string" },
          "likelihoodScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidenceCitations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "clinicalSafetyNotes": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
