{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PatientState",
  "type": "object",
  "required": ["sessionId", "patientId", "demographics", "chiefComplaint", "answeredQuestions"],
  "properties": {
    "sessionId": { "type": "string" },
    "patientId": { "type": "string" },
    "demographics": {
      "type": "object",
      "required": ["age", "gender"],
      "properties": {
        "age": { "type": "number", "minimum": 0, "maximum": 130 },
        "gender": { "type": "string", "enum": ["MALE", "FEMALE", "OTHER"] },
        "district": { "type": "string" },
        "state": { "type": "string" },
        "facilityId": { "type": "string" }
      }
    },
    "chiefComplaint": { "type": "string" },
    "reportedSymptoms": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "answeredQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["questionId", "answerValue", "answeredAt"],
        "properties": {
          "questionId": { "type": "string" },
          "questionText": { "type": "string" },
          "answerValue": { "type": "string" },
          "isRedFlagTrigger": { "type": "boolean", "default": false },
          "answeredAt": { "type": "string", "format": "date-time" }
        }
      },
      "default": []
    },
    "vitals": {
      "type": "object",
      "properties": {
        "systolicBp": { "type": "number" },
        "diastolicBp": { "type": "number" },
        "heartRate": { "type": "number" },
        "spo2": { "type": "number" },
        "temperatureF": { "type": "number" }
      }
    },
    "currentMedications": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "knownAllergies": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "additionalProperties": false
}
