{
  "name": "medikiosk",
  "private": true,
  "version": "0.1.0",
  "description": "MediKiosk - AI-powered multilingual clinical history & medical document intake kiosk (SIH prototype)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter=./apps/* run dev",
    "build": "pnpm --recursive --filter=./apps/* run build",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "pnpm --filter backend prisma:generate",
    "prisma:migrate": "pnpm --filter backend prisma:migrate",
    "prisma:seed": "pnpm --filter backend prisma:seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
