generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum crdb_internal_region {
  aws_ap_south_1 @map("aws-ap-south-1")
}

enum ConsentStatus {
  PENDING
  GRANTED
  DECLINED
  REVOKED
}

enum DocumentType {
  PRESCRIPTION
  LAB_REPORT
  DISCHARGE_SUMMARY
  OTHER
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SessionStatus {
  CREATED
  IDENTIFIED
  CONSENTED
  IN_HISTORY
  DOCUMENTS
  SUMMARY_READY
  ROUTED
  IN_CONSULT
  COMPLETED
  ABANDONED
}

enum Mode {
  GENERAL
  AYUSH
}

enum Language {
  EN
  HI
  BN
  MR
  TE
  TA
  GU
  KN
  ML
  PA
  OR
  AS
  UR
}

enum ExtractionFieldStatus {
  VERIFIED
  NEEDS_VERIFICATION
}

enum TimelineEventType {
  DIAGNOSIS
  MEDICATION
  INVESTIGATION
  PROCEDURE
  VISIT
}

enum ActorType {
  PATIENT
  DOCTOR
  ADMIN
  SYSTEM
  DEVICE
}

enum IdentificationMethod {
  RFID
  QR
  MANUAL
  DEMO
}

enum AISummaryStatus {
  DRAFT
  CONFIRMED
}

enum ConsultationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DoctorRole {
  DOCTOR
  ADMIN
}

enum HospitalType {
  AIIMS
  TERTIARY_HOSPITAL
  DISTRICT_HOSPITAL
  COMMUNITY_HEALTH_CENTRE
  PRIMARY_HEALTH_CENTRE
  PRIVATE_HOSPITAL
}

enum TriagePriority {
  NORMAL
  URGENT
  EMERGENCY
}

enum QueueStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
}

enum DoctorStatus {
  AVAILABLE
  IN_CONSULTATION
  OFF_DUTY
}

enum KioskStatus {
  ONLINE
  DEGRADED
  OFFLINE
}

enum PrescriptionFrequency {
  OD
  BD
  TDS
  QID
  PRN
  SOS
}

// ---------------------------------------------------------------------------
// Multi-Hospital & Facility Governance (Central Admin & Hospital Admin)
// ---------------------------------------------------------------------------

model Hospital {
  id             String       @id @default(cuid())
  code           String       @unique // e.g. "AIIMS-DEL-01"
  name           String       // "All India Institute of Medical Sciences, New Delhi"
  type           HospitalType @default(AIIMS)
  state          String       // "Delhi"
  district       String       // "New Delhi"
  city           String       // "New Delhi"
  pinCode        String?
  address        String?
  latitude       Float?
  longitude      Float?
  contactPhone   String?
  contactEmail   String?
  totalBeds      Int          @default(2500)
  availableBeds  Int          @default(340)
  totalKiosks    Int          @default(12)
  activeKiosks   Int          @default(11)
  abdmFacilityId String?      @unique // HFR ID e.g. "IN0710000001"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  departments  Department[]
  doctors      Doctor[]
  kiosks       RFIDDevice[]
  rfidCards    RFIDCard[]
  sessions     PatientSession[]
  triageQueues TriageQueue[]
  patients     Patient[]
  outbreaks    DiseaseOutbreakSignal[]
}

model Department {
  id               String   @id @default(cuid())
  hospitalId       String
  name             String   // "Cardiology", "General Medicine", "Pediatrics", "AYUSH", "Emergency"
  code             String   // "CARD", "GEN", "PED", "AYU", "EMG"
  floor            String?  // "Ground Floor", "1st Floor"
  roomNumber       String?  // "Room 102"
  active           Boolean  @default(true)
  headOfDepartment String?
  createdAt        DateTime @default(now())

  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  doctors      Doctor[]
  triageQueues TriageQueue[]

  @@unique([hospitalId, code])
}

// ---------------------------------------------------------------------------
// Patient & Smart Card Models (Patient Kiosk & RFID Portal)
// ---------------------------------------------------------------------------

model Patient {
  id                 String               @id @default(cuid())
  hospitalId         String?
  fullName           String
  dateOfBirth        DateTime?
  age                Int?
  gender             String?
  bloodGroup         String?
  phone              String?              @unique
  abhaId             String?
  registrationSource IdentificationMethod
  isDemo             Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  hospital          Hospital?              @relation(fields: [hospitalId], references: [id])
  rfidCards         RFIDCard[]
  sessions          PatientSession[]
  clinicalHistories ClinicalHistory[]
  documents         MedicalDocument[]
  timelineEvents    MedicalTimelineEvent[]
  consultations     Consultation[]
  alerts            Alert[]
  aiSummaries       AISummary[]
  triageQueues      TriageQueue[]
  vitals            PatientVitals[]
  prescriptions     Prescription[]
  abdmConsents      AbdmConsentArtefact[]
}

model RFIDDevice {
  id                 String      @id @default(cuid())
  hospitalId         String?
  deviceCode         String      @unique
  location           String?
  kioskType          String?     @default("SELF_SERVICE")
  status             KioskStatus @default(ONLINE)
  printerPaperPercent Int?       @default(85)
  lastHeartbeatAt    DateTime?
  firmwareVersion    String?
  ipAddress          String?
  isDemo             Boolean     @default(false)
  createdAt          DateTime    @default(now())

  hospital Hospital?        @relation(fields: [hospitalId], references: [id])
  sessions PatientSession[]
}

model RFIDCard {
  id         String   @id @default(cuid())
  hospitalId String?
  uid        String   @unique
  patientId  String?
  cardType   String?  @default("STANDARD_MIFARE")
  isDemo     Boolean  @default(false)
  active     Boolean  @default(true)
  issuedAt   DateTime @default(now())

  hospital Hospital? @relation(fields: [hospitalId], references: [id])
  patient  Patient?  @relation(fields: [patientId], references: [id])
}

// ---------------------------------------------------------------------------
// Patient Intake Session (Kiosk Lifecycle)
// ---------------------------------------------------------------------------

model PatientSession {
  id            String                @id @default(cuid())
  hospitalId    String?
  patientId     String?
  deviceId      String?
  status        SessionStatus         @default(CREATED)
  mode          Mode                  @default(GENERAL)
  language      Language              @default(EN)
  isDemo        Boolean               @default(false)
  identifiedVia IdentificationMethod?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  hospital        Hospital?        @relation(fields: [hospitalId], references: [id])
  patient         Patient?         @relation(fields: [patientId], references: [id])
  device          RFIDDevice?      @relation(fields: [deviceId], references: [id])
  consent         Consent?
  clinicalHistory ClinicalHistory?
  documents       MedicalDocument[]
  aiSummary       AISummary?
  consultation    Consultation?
  triageQueue     TriageQueue?
  vitals          PatientVitals?
  alerts          Alert[]
}

model Consent {
  id                 String        @id @default(cuid())
  sessionId          String        @unique
  status             ConsentStatus @default(PENDING)
  language           Language
  consentTextVersion String
  grantedAt          DateTime?
  ipAddress          String?
  createdAt          DateTime      @default(now())

  session PatientSession @relation(fields: [sessionId], references: [id])
}

model ClinicalHistory {
  id                     String    @id @default(cuid())
  sessionId              String    @unique
  patientId              String
  mode                   Mode
  chiefComplaint         String?
  chiefComplaintCategory String?
  currentTreeId          String?
  currentNodeId          String?
  hpi                    Json?
  pastMedicalHistory     Json?
  pastSurgicalHistory    Json?
  currentMedications     Json?
  drugAllergies          Json?
  familyHistory          Json?
  personalHistory        Json?
  reviewOfSystems        Json?
  previousInvestigations Json?
  ayushFields            Json?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())

  session PatientSession   @relation(fields: [sessionId], references: [id])
  patient Patient          @relation(fields: [patientId], references: [id])
  answers ClinicalAnswer[]
}

model ClinicalAnswer {
  id                    String   @id @default(cuid())
  clinicalHistoryId     String
  nodeId                String
  section               String
  questionText          String
  questionTextLocalized Json?
  answerValue           Json
  isRedFlagTrigger      Boolean  @default(false)
  answeredAt            DateTime @default(now())

  clinicalHistory ClinicalHistory @relation(fields: [clinicalHistoryId], references: [id])
}

model PatientVitals {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  patientId    String
  systolicBp   Int?     // e.g. 120
  diastolicBp  Int?     // e.g. 80
  pulse        Int?     // e.g. 72
  spo2         Int?     // e.g. 98
  temperatureF Float?   // e.g. 98.6
  heightCm     Float?   // e.g. 172
  weightKg     Float?   // e.g. 68
  bmi          Float?   // e.g. 23.0
  source       String?  @default("KIOSK_IOT")
  recordedAt   DateTime @default(now())

  session PatientSession @relation(fields: [sessionId], references: [id])
  patient Patient        @relation(fields: [patientId], references: [id])
}

// ---------------------------------------------------------------------------
// Document OCR & Multimodal Ingestion (ImageKit + Gemini Vision)
// ---------------------------------------------------------------------------

model MedicalDocument {
  id               String       @id @default(cuid())
  sessionId        String
  patientId        String
  type             DocumentType
  originalFilename String
  storagePath      String
  mimeType         String
  ocrText          String?
  ocrConfidence    Float?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())

  session        PatientSession         @relation(fields: [sessionId], references: [id])
  patient        Patient                @relation(fields: [patientId], references: [id])
  extractedData  ExtractedMedicalData[]
  timelineEvents MedicalTimelineEvent[]
}

model ExtractedMedicalData {
  id         String                @id @default(cuid())
  documentId String
  fieldType  String
  fieldValue String
  confidence Float
  status     ExtractionFieldStatus @default(NEEDS_VERIFICATION)
  verifiedBy String?
  verifiedAt DateTime?

  document MedicalDocument @relation(fields: [documentId], references: [id])
}

model MedicalTimelineEvent {
  id               String            @id @default(cuid())
  patientId        String
  sourceDocumentId String?
  eventType        TimelineEventType
  eventDate        DateTime?
  title            String
  description      String?
  metadata         Json?
  createdAt        DateTime          @default(now())

  patient        Patient          @relation(fields: [patientId], references: [id])
  sourceDocument MedicalDocument? @relation(fields: [sourceDocumentId], references: [id])
}

model AISummary {
  id                  String          @id @default(cuid())
  sessionId           String          @unique
  patientId           String
  content             String
  generatorType       String
  status              AISummaryStatus @default(DRAFT)
  editedContent       String?
  confirmedByDoctorId String?
  confirmedAt         DateTime?
  createdAt           DateTime        @default(now())

  session PatientSession @relation(fields: [sessionId], references: [id])
  patient Patient        @relation(fields: [patientId], references: [id])
}

// ---------------------------------------------------------------------------
// Live OPD Queue & Triage Routing (Kiosk -> Hospital Admin -> Doctor Dashboard)
// ---------------------------------------------------------------------------

model TriageQueue {
  id                String         @id @default(cuid())
  sessionId         String         @unique
  patientId         String
  hospitalId        String
  departmentId      String?
  doctorId          String?
  tokenNumber       String         // e.g. "CARD-102"
  priority          TriagePriority @default(NORMAL)
  status            QueueStatus    @default(WAITING)
  estimatedWaitMins Int            @default(15)
  queuedAt          DateTime       @default(now())
  calledAt          DateTime?
  completedAt       DateTime?

  session    PatientSession @relation(fields: [sessionId], references: [id])
  patient    Patient        @relation(fields: [patientId], references: [id])
  hospital   Hospital       @relation(fields: [hospitalId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  doctor     Doctor?        @relation(fields: [doctorId], references: [id])

  @@index([hospitalId, status])
  @@index([doctorId, status])
}

// ---------------------------------------------------------------------------
// Clinical Consultation & Digital Prescriptions (Doctor Dashboard)
// ---------------------------------------------------------------------------

model Doctor {
  id                 String       @id @default(cuid())
  hospitalId         String?
  departmentId       String?
  name               String
  email              String       @unique
  passwordHash       String
  role               DoctorRole   @default(DOCTOR)
  status             DoctorStatus @default(AVAILABLE)
  department         String?      // text label fallback
  roomNumber         String?
  qualification      String?
  registrationNumber String?
  avgConsultMinutes  Float?       @default(4.5)
  createdAt          DateTime     @default(now())

  hospital      Hospital?      @relation(fields: [hospitalId], references: [id])
  departmentRel Department?    @relation(fields: [departmentId], references: [id])
  consultations Consultation[]
  triageQueues  TriageQueue[]
  prescriptions Prescription[]
}

model Consultation {
  id          String             @id @default(cuid())
  sessionId   String             @unique
  patientId   String
  doctorId    String?
  status      ConsultationStatus @default(PENDING)
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?

  session      PatientSession @relation(fields: [sessionId], references: [id])
  patient      Patient        @relation(fields: [patientId], references: [id])
  doctor       Doctor?        @relation(fields: [doctorId], references: [id])
  prescription Prescription?
}

model Prescription {
  id             String             @id @default(cuid())
  consultationId String             @unique
  patientId      String
  doctorId       String
  diagnosis      String
  clinicalNotes  String?
  followUpDays   Int?               @default(7)
  dispensed      Boolean            @default(false)
  dispensedAt    DateTime?
  createdAt      DateTime           @default(now())

  consultation Consultation       @relation(fields: [consultationId], references: [id])
  patient      Patient            @relation(fields: [patientId], references: [id])
  doctor       Doctor             @relation(fields: [doctorId], references: [id])
  items        PrescriptionItem[]
}

model PrescriptionItem {
  id             String                @id @default(cuid())
  prescriptionId String
  medicineName   String                // "Pantop 40mg", "Paracetamol 500mg"
  dosage         String?               // "1 Tablet"
  frequency      PrescriptionFrequency @default(BD)
  durationDays   Int                   @default(5)
  instructions   String?               // "After food", "Empty stomach"
  timing         String?               // "Morning & Evening"

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Alerts, Audit & ABDM Compliance (Central Admin & Governance)
// ---------------------------------------------------------------------------

model Alert {
  id                     String        @id @default(cuid())
  sessionId              String
  patientId              String
  severity               AlertSeverity
  triggerType            String
  message                String
  triggeredByAnswerId    String?
  acknowledged           Boolean       @default(false)
  acknowledgedByDoctorId String?
  acknowledgedAt         DateTime?
  createdAt              DateTime      @default(now())

  session PatientSession @relation(fields: [sessionId], references: [id])
  patient Patient        @relation(fields: [patientId], references: [id])
}

model DiseaseOutbreakSignal {
  id           String        @id @default(cuid())
  hospitalId   String
  diseaseName  String        // "Dengue Fever", "Malaria", "Typhoid", "Viral Influenza"
  category     String?       // "VECTOR_BORNE", "RESPIRATORY", "WATER_BORNE"
  icd10Code    String?       // "A90", "B54", "A01.0"
  caseCount    Int           @default(1)
  severity     AlertSeverity @default(MEDIUM)
  district     String
  state        String
  reportedDate DateTime      @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@index([state, district, diseaseName])
}

model AbdmConsentArtefact {
  id                String        @id @default(cuid())
  patientId         String
  abhaAddress       String
  consentArtefactId String        @unique
  hipId             String        // Hospital Health Information Provider ID
  hiuId             String?       // Health Information User ID
  purpose           String        @default("CARETREAT")
  status            ConsentStatus @default(GRANTED)
  dateFrom          DateTime?
  dateTo            DateTime?
  expiryDate        DateTime
  createdAt         DateTime      @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())
}

model OtpVerification {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}
