generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ConsentStatus {
  PENDING
  GRANTED
  DECLINED
}

enum DocumentType {
  PRESCRIPTION
  LAB_REPORT
  DISCHARGE_SUMMARY
  OTHER
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SessionStatus {
  CREATED
  IDENTIFIED
  CONSENTED
  IN_HISTORY
  DOCUMENTS
  SUMMARY_READY
  ROUTED
  IN_CONSULT
  COMPLETED
  ABANDONED
}

enum Mode {
  GENERAL
  AYUSH
}

enum Language {
  EN
  HI
  BN
  MR
  TE
  TA
  GU
  KN
  ML
  PA
  OR
  AS
  UR
}

enum ExtractionFieldStatus {
  VERIFIED
  NEEDS_VERIFICATION
}

enum TimelineEventType {
  DIAGNOSIS
  MEDICATION
  INVESTIGATION
  PROCEDURE
  VISIT
}

enum ActorType {
  PATIENT
  DOCTOR
  SYSTEM
  DEVICE
}

enum IdentificationMethod {
  RFID
  QR
  MANUAL
  DEMO
}

enum AISummaryStatus {
  DRAFT
  CONFIRMED
}

enum ConsultationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DoctorRole {
  DOCTOR
  ADMIN
}

// Hospital Admin Domain Enums
enum FacilityType {
  GOVERNMENT_HOSPITAL
  AIIMS
  PRIMARY_HEALTH_CENTRE
  COMMUNITY_HEALTH_CENTRE
  DISTRICT_HOSPITAL
  PRIVATE_HOSPITAL
}

enum DepartmentLoadStatus {
  OPTIMAL
  HIGH_LOAD
  OVER_CAPACITY
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
  FULL_DAY
}

enum DoctorDutyStatus {
  AVAILABLE
  IN_CONSULTATION
  ON_BREAK
  OFF_DUTY
}

enum QueuePriority {
  NORMAL
  SENIOR_CITIZEN
  EMERGENCY_RED_FLAG
}

enum QueueStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
  TRANSFERRED
}

enum KioskOperationalMode {
  GENERAL_OPD
  AYUSH_MODE
  EMERGENCY_PRIORITY
}

enum ComponentHealthStatus {
  HEALTHY
  DEGRADED
  FAULTY
  OFFLINE
}

enum PrinterHealthStatus {
  HEALTHY
  PAPER_LOW
  PAPER_OUT
  JAMMED
  OFFLINE
}

enum RfidCardType {
  MIFARE_CLASSIC_1K
  NTAG215
  DESFIRE_EV1
  OTHER
}

enum RfidCardStockStatus {
  IN_STOCK
  ACTIVE_ISSUED
  DAMAGED
  BLOCKED
  RETURNED
}

enum HisSystemType {
  NIC_E_HOSPITAL
  CUSTOM_FHIR_R4
  OPEN_MRS
  BAHMNI
  MEDIKIOSK_STANDALONE
}

enum IntegrationHealthStatus {
  HEALTHY
  SYNCING
  DEGRADED
  DISCONNECTED
}

enum IncidentType {
  PRINTER_PAPER_LOW
  RFID_MODULE_FAULT
  OCR_CAMERA_DEGRADED
  NETWORK_OFFLINE
  RED_FLAG_OVERFLOW
  GENERAL_MAINTENANCE
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  DISPATCHED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum HospitalStaffRole {
  MEDICAL_SUPERINTENDENT
  OPERATIONS_ADMIN
  OPD_SUPERVISOR
  KIOSK_TECHNICIAN
  REGISTRATION_CLERK
}

// ---------------------------------------------------------------------------
// Patient Portal Domain Enums
// ---------------------------------------------------------------------------

enum AppointmentType {
  IN_PERSON
  VIDEO_CONSULT
  FOLLOW_UP
  EMERGENCY
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum BillingStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  CASH
  ABDM_INSURANCE
}

enum PatientNotificationType {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  PRESCRIPTION_ISSUED
  LAB_REPORT_READY
  BILL_GENERATED
  BILL_PAID
  HEALTH_ALERT
}

// ---------------------------------------------------------------------------
// Core Clinical & Kiosk Models
// ---------------------------------------------------------------------------

model Patient {
  id                   String               @id @default(cuid())
  fullName             String
  dateOfBirth          DateTime?
  gender               String?
  phone                String?              @unique
  email                String?              @unique
  passwordHash         String?
  bloodGroup           String?
  address              String?
  emergencyContact     String?
  emergencyPhone       String?
  abhaId               String?
  registrationSource   IdentificationMethod
  isDemo               Boolean              @default(false)
  registeredFacilityId String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  registeredFacility HospitalFacility?      @relation(fields: [registeredFacilityId], references: [id])
  rfidCards          RFIDCard[]
  sessions           PatientSession[]
  clinicalHistories  ClinicalHistory[]
  documents          MedicalDocument[]
  timelineEvents     MedicalTimelineEvent[]
  consultations      Consultation[]
  alerts             Alert[]
  aiSummaries        AISummary[]
  queueEntries       PatientQueueEntry[]
  appointments       Appointment[]
  invoices           BillingInvoice[]
  notifications      PatientNotification[]
  prescriptions      PatientPrescription[]
}

model RFIDDevice {
  id              String    @id @default(cuid())
  deviceCode      String    @unique
  location        String?
  lastHeartbeatAt DateTime?
  firmwareVersion String?
  ipAddress       String?
  isDemo          Boolean   @default(false)
  facilityId      String?
  createdAt       DateTime  @default(now())

  facility             HospitalFacility?     @relation(fields: [facilityId], references: [id])
  sessions             PatientSession[]
  kioskProfile         KioskTerminalProfile?
  maintenanceIncidents MaintenanceIncident[]
}

model RFIDCard {
  id          String              @id @default(cuid())
  uid         String              @unique
  patientId   String?
  facilityId  String?
  batchId     String?
  isDemo      Boolean             @default(false)
  active      Boolean             @default(true)
  stockStatus RfidCardStockStatus @default(ACTIVE_ISSUED)
  issuedAt    DateTime            @default(now())

  patient  Patient?            @relation(fields: [patientId], references: [id])
  facility HospitalFacility?   @relation(fields: [facilityId], references: [id])
  batch    RfidInventoryBatch? @relation(fields: [batchId], references: [id])
}

model PatientSession {
  id            String                @id @default(cuid())
  patientId     String?
  deviceId      String?
  facilityId    String?
  departmentId  String?
  status        SessionStatus         @default(CREATED)
  mode          Mode                  @default(GENERAL)
  language      Language              @default(EN)
  isDemo        Boolean               @default(false)
  identifiedVia IdentificationMethod?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  patient         Patient?          @relation(fields: [patientId], references: [id])
  device          RFIDDevice?       @relation(fields: [deviceId], references: [id])
  facility        HospitalFacility? @relation(fields: [facilityId], references: [id])
  department      Department?       @relation(fields: [departmentId], references: [id])
  consent         Consent?
  clinicalHistory ClinicalHistory?
  documents       MedicalDocument[]
  aiSummary       AISummary?
  consultation    Consultation?
  alerts          Alert[]
  queueEntry      PatientQueueEntry?
}

model Consent {
  id                 String        @id @default(cuid())
  sessionId          String        @unique
  status             ConsentStatus @default(PENDING)
  language           Language
  consentTextVersion String
  grantedAt          DateTime?
  ipAddress          String?
  createdAt          DateTime      @default(now())

  session PatientSession @relation(fields: [sessionId], references: [id])
}

model ClinicalHistory {
  id                     String    @id @default(cuid())
  sessionId              String    @unique
  patientId              String
  mode                   Mode
  chiefComplaint         String?
  chiefComplaintCategory String?
  currentTreeId          String?
  currentNodeId          String?
  hpi                    Json?
  pastMedicalHistory     Json?
  pastSurgicalHistory    Json?
  currentMedications     Json?
  drugAllergies          Json?
  familyHistory          Json?
  personalHistory        Json?
  reviewOfSystems        Json?
  previousInvestigations Json?
  ayushFields            Json?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())

  session PatientSession   @relation(fields: [sessionId], references: [id])
  patient Patient          @relation(fields: [patientId], references: [id])
  answers ClinicalAnswer[]
}

model ClinicalAnswer {
  id                    String   @id @default(cuid())
  clinicalHistoryId     String
  nodeId                String
  section               String
  questionText          String
  questionTextLocalized Json?
  answerValue           Json
  isRedFlagTrigger      Boolean  @default(false)
  answeredAt            DateTime @default(now())

  clinicalHistory ClinicalHistory @relation(fields: [clinicalHistoryId], references: [id])
}

model MedicalDocument {
  id               String       @id @default(cuid())
  sessionId        String
  patientId        String
  type             DocumentType
  originalFilename String
  storagePath      String
  mimeType         String
  ocrText          String?
  ocrConfidence    Float?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())

  session        PatientSession         @relation(fields: [sessionId], references: [id])
  patient        Patient                @relation(fields: [patientId], references: [id])
  extractedData  ExtractedMedicalData[]
  timelineEvents MedicalTimelineEvent[]
}

model ExtractedMedicalData {
  id         String                @id @default(cuid())
  documentId String
  fieldType  String
  fieldValue String
  confidence Float
  status     ExtractionFieldStatus @default(NEEDS_VERIFICATION)
  verifiedBy String?
  verifiedAt DateTime?

  document MedicalDocument @relation(fields: [documentId], references: [id])
}

model MedicalTimelineEvent {
  id               String            @id @default(cuid())
  patientId        String
  sourceDocumentId String?
  eventType        TimelineEventType
  eventDate        DateTime?
  title            String
  description      String?
  metadata         Json?
  createdAt        DateTime          @default(now())

  patient        Patient          @relation(fields: [patientId], references: [id])
  sourceDocument MedicalDocument? @relation(fields: [sourceDocumentId], references: [id])
}

model AISummary {
  id                  String          @id @default(cuid())
  sessionId           String          @unique
  patientId           String
  content             String
  generatorType       String
  status              AISummaryStatus @default(DRAFT)
  editedContent       String?
  confirmedByDoctorId String?
  confirmedAt         DateTime?
  createdAt           DateTime        @default(now())

  session PatientSession @relation(fields: [sessionId], references: [id])
  patient Patient        @relation(fields: [patientId], references: [id])
}

model Doctor {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         DoctorRole @default(DOCTOR)
  department   String?
  facilityId   String?
  departmentId String?
  createdAt    DateTime   @default(now())

  facility          HospitalFacility?  @relation(fields: [facilityId], references: [id])
  dept              Department?        @relation(fields: [departmentId], references: [id])
  consultations     Consultation[]
  rosters           DoctorRoster[]
  assignedRooms     ConsultationRoom[] @relation("CurrentRoomDoctor")
  queueEntries      PatientQueueEntry[]
  headedDepartments Department[]       @relation("DepartmentHead")
  appointments      Appointment[]
  prescriptions     PatientPrescription[]
}

model Consultation {
  id          String             @id @default(cuid())
  sessionId   String             @unique
  patientId   String
  doctorId    String?
  status      ConsultationStatus @default(PENDING)
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?

  session PatientSession @relation(fields: [sessionId], references: [id])
  patient Patient        @relation(fields: [patientId], references: [id])
  doctor  Doctor?        @relation(fields: [doctorId], references: [id])
}

model Alert {
  id                     String        @id @default(cuid())
  sessionId              String
  patientId              String
  facilityId             String?
  severity               AlertSeverity
  triggerType            String
  message                String
  triggeredByAnswerId    String?
  acknowledged           Boolean       @default(false)
  acknowledgedByDoctorId String?
  acknowledgedAt         DateTime?
  createdAt              DateTime      @default(now())

  session  PatientSession    @relation(fields: [sessionId], references: [id])
  patient  Patient           @relation(fields: [patientId], references: [id])
  facility HospitalFacility? @relation(fields: [facilityId], references: [id])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Hospital Admin & Facility Management Models
// ---------------------------------------------------------------------------

model HospitalFacility {
  id             String       @id @default(cuid())
  facilityCode   String       @unique
  name           String
  type           FacilityType @default(AIIMS)
  abdmFacilityId String?
  address        String?
  city           String
  state          String
  pincode        String?
  contactPhone   String?
  contactEmail   String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  departments          Department[]
  consultationRooms    ConsultationRoom[]
  staff                HospitalStaff[]
  doctors              Doctor[]
  devices              RFIDDevice[]
  cards                RFIDCard[]
  patients             Patient[]
  sessions             PatientSession[]
  alerts               Alert[]
  kioskProfiles        KioskTerminalProfile[]
  inventoryBatches     RfidInventoryBatch[]
  integrationConfig    HospitalIntegrationConfig?
  maintenanceIncidents MaintenanceIncident[]
  metricSnapshots      OpdMetricSnapshot[]
  queueEntries         PatientQueueEntry[]
  rosters              DoctorRoster[]
  appointments         Appointment[]
}

model Department {
  id                String               @id @default(cuid())
  facilityId        String
  name              String
  code              String
  wingOrBlock       String?
  floor             String?
  dailyCapacity     Int                  @default(80)
  currentLoadStatus DepartmentLoadStatus @default(OPTIMAL)
  mode              Mode                 @default(GENERAL)
  isActive          Boolean              @default(true)
  headDoctorId      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  facility     HospitalFacility       @relation(fields: [facilityId], references: [id])
  headDoctor   Doctor?                @relation("DepartmentHead", fields: [headDoctorId], references: [id])
  doctors      Doctor[]
  rooms        ConsultationRoom[]
  rosters      DoctorRoster[]
  queueEntries PatientQueueEntry[]
  sessions     PatientSession[]
  kiosks       KioskTerminalProfile[]
  appointments Appointment[]

  @@unique([facilityId, code])
}

model ConsultationRoom {
  id              String   @id @default(cuid())
  facilityId      String
  departmentId    String
  roomNumber      String
  roomName        String
  floor           String?
  isActive        Boolean  @default(true)
  currentDoctorId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facility      HospitalFacility @relation(fields: [facilityId], references: [id])
  department    Department       @relation(fields: [departmentId], references: [id])
  currentDoctor Doctor?          @relation("CurrentRoomDoctor", fields: [currentDoctorId], references: [id])
  rosters       DoctorRoster[]

  @@unique([facilityId, roomNumber])
}

model DoctorRoster {
  id                    String           @id @default(cuid())
  facilityId            String
  doctorId              String
  departmentId          String
  roomId                String?
  shiftDate             DateTime         @default(now())
  shiftType             ShiftType        @default(MORNING)
  status                DoctorDutyStatus @default(AVAILABLE)
  patientsWaitingCount  Int              @default(0)
  patientsServedCount   Int              @default(0)
  avgConsultTimeMinutes Float            @default(4.0)
  aiVerificationRate    Float            @default(99.0)
  checkInTime           DateTime?
  checkOutTime          DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  facility     HospitalFacility    @relation(fields: [facilityId], references: [id])
  doctor       Doctor              @relation(fields: [doctorId], references: [id])
  department   Department          @relation(fields: [departmentId], references: [id])
  room         ConsultationRoom?   @relation(fields: [roomId], references: [id])
  queueEntries PatientQueueEntry[]

  @@index([facilityId, shiftDate, status])
}

model PatientQueueEntry {
  id                    String        @id @default(cuid())
  facilityId            String
  departmentId          String
  sessionId             String        @unique
  patientId             String
  rosterId              String?
  doctorId              String?
  tokenNumber           String
  priority              QueuePriority @default(NORMAL)
  status                QueueStatus   @default(WAITING)
  queuePosition         Int           @default(1)
  estimatedWaitMinutes  Int           @default(10)
  calledAt              DateTime?
  consultationStartedAt DateTime?
  completedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  facility   HospitalFacility @relation(fields: [facilityId], references: [id])
  department Department       @relation(fields: [departmentId], references: [id])
  session    PatientSession   @relation(fields: [sessionId], references: [id])
  patient    Patient          @relation(fields: [patientId], references: [id])
  roster     DoctorRoster?    @relation(fields: [rosterId], references: [id])
  doctor     Doctor?          @relation(fields: [doctorId], references: [id])

  @@index([facilityId, departmentId, status])
}

model KioskTerminalProfile {
  id                      String                @id @default(cuid())
  facilityId              String
  deviceId                String                @unique
  assignedDepartmentId    String?
  terminalCode            String                @unique
  mode                    KioskOperationalMode  @default(GENERAL_OPD)
  rfidReaderStatus        ComponentHealthStatus @default(HEALTHY)
  ocrCameraStatus         ComponentHealthStatus @default(HEALTHY)
  printerStatus           PrinterHealthStatus   @default(HEALTHY)
  printerPaperLevel       Int                   @default(100)
  touchscreenStatus       ComponentHealthStatus @default(HEALTHY)
  batteryBackupPercentage Int?                  @default(100)
  lastSelfTestAt          DateTime?             @default(now())
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  facility             HospitalFacility      @relation(fields: [facilityId], references: [id])
  device               RFIDDevice            @relation(fields: [deviceId], references: [id])
  department           Department?           @relation(fields: [assignedDepartmentId], references: [id])
  maintenanceIncidents MaintenanceIncident[]
}

model RfidInventoryBatch {
  id                   String       @id @default(cuid())
  facilityId           String
  batchNumber          String
  cardType             RfidCardType @default(MIFARE_CLASSIC_1K)
  totalAllocated       Int          @default(0)
  availableStock       Int          @default(0)
  issuedCount          Int          @default(0)
  damagedReturnedCount Int          @default(0)
  reorderThreshold     Int          @default(200)
  unitCost             Float?       @default(0.0)
  receivedDate         DateTime     @default(now())
  supplier             String?      @default("National Health Mission Supply")
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  facility HospitalFacility @relation(fields: [facilityId], references: [id])
  cards    RFIDCard[]

  @@unique([facilityId, batchNumber])
}

model HospitalIntegrationConfig {
  id                  String                  @id @default(cuid())
  facilityId          String                  @unique
  hisType             HisSystemType           @default(CUSTOM_FHIR_R4)
  fhirGatewayUrl      String                  @default("https://fhir.aiims.edu/r4/v1")
  hfrFacilityId       String?                 @default("HOSP-DEL-AIIMS")
  isLinkedHfr         Boolean                 @default(true)
  syncEnabled         Boolean                 @default(true)
  syncIntervalSeconds Int                     @default(60)
  lastSyncAt          DateTime?
  syncHealthStatus    IntegrationHealthStatus @default(HEALTHY)
  uptimePercentage    Float                   @default(99.9)
  abdmMilestone1      Boolean                 @default(true)
  abdmMilestone2      Boolean                 @default(true)
  abdmMilestone3      Boolean                 @default(true)
  authClientId        String?
  authClientSecret    String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  facility HospitalFacility @relation(fields: [facilityId], references: [id])
}

model MaintenanceIncident {
  id              String           @id @default(cuid())
  facilityId      String
  kioskProfileId  String?
  deviceId        String?
  title           String
  description     String
  incidentType    IncidentType     @default(GENERAL_MAINTENANCE)
  severity        IncidentSeverity @default(LOW)
  status          IncidentStatus   @default(OPEN)
  assignedStaff   String?
  dispatchedAt    DateTime?
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  facility     HospitalFacility      @relation(fields: [facilityId], references: [id])
  kioskProfile KioskTerminalProfile? @relation(fields: [kioskProfileId], references: [id])
  device       RFIDDevice?           @relation(fields: [deviceId], references: [id])

  @@index([facilityId, status, severity])
}

model HospitalStaff {
  id           String            @id @default(cuid())
  facilityId   String
  name         String
  email        String            @unique
  passwordHash String
  role         HospitalStaffRole @default(OPERATIONS_ADMIN)
  designation  String?
  phone        String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  facility HospitalFacility @relation(fields: [facilityId], references: [id])
}

model OpdMetricSnapshot {
  id                     String   @id @default(cuid())
  facilityId             String
  snapshotDate           DateTime
  hour                   Int?
  totalPatientIntake     Int      @default(0)
  generalOpdIntake       Int      @default(0)
  ayushIntake            Int      @default(0)
  emergencyIntake        Int      @default(0)
  doctorsOnDuty          Int      @default(0)
  avgTriageMinutes       Float    @default(4.2)
  redFlagAlerts          Int      @default(0)
  kioskOffloadPercentage Float    @default(85.0)
  createdAt              DateTime @default(now())

  facility HospitalFacility @relation(fields: [facilityId], references: [id])

  @@index([facilityId, snapshotDate])
}

// ---------------------------------------------------------------------------
// Patient Portal Domain Models
// ---------------------------------------------------------------------------

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String
  doctorId           String?
  facilityId         String?
  departmentId       String?
  appointmentDate    DateTime
  timeSlot           String
  type               AppointmentType   @default(IN_PERSON)
  status             AppointmentStatus @default(SCHEDULED)
  reason             String
  notes              String?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patient    Patient           @relation(fields: [patientId], references: [id])
  doctor     Doctor?           @relation(fields: [doctorId], references: [id])
  facility   HospitalFacility? @relation(fields: [facilityId], references: [id])
  department Department?       @relation(fields: [departmentId], references: [id])
  invoices   BillingInvoice[]

  @@index([patientId, appointmentDate])
  @@index([doctorId, appointmentDate])
}

model BillingInvoice {
  id                   String         @id @default(cuid())
  patientId            String
  appointmentId        String?
  invoiceNumber        String         @unique
  description          String
  department           String?
  totalAmount          Float
  discountAmount       Float          @default(0)
  netAmount            Float
  status               BillingStatus  @default(PENDING)
  paymentMethod        PaymentMethod?
  paymentDate          DateTime?
  transactionReference String?
  items                Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([patientId, status])
}

model PatientNotification {
  id        String                  @id @default(cuid())
  patientId String
  title     String
  message   String
  type      PatientNotificationType
  read      Boolean                 @default(false)
  actionUrl String?
  createdAt DateTime                @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, read, createdAt])
}

model PatientPrescription {
  id               String   @id @default(cuid())
  patientId        String
  doctorId         String?
  appointmentId    String?
  prescriptionDate DateTime @default(now())
  diagnosis        String
  instructions     String?
  medications      Json
  pdfUrl           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor? @relation(fields: [doctorId], references: [id])

  @@index([patientId, prescriptionDate])
}
